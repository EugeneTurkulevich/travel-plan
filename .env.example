# УВАГА: справжній .env живе НЕ тут, а в корені ДАНИХ (напр. ../travel-data/.env),
# бо токен — це твоя приватна річ, а цей репозиторій публічний.
# Тут лише перелік змінних, які читає cloud_push.py / mcp_probe.py.

# Refresh-токен MCP-воркера. Видається при підключенні агента до карти
# (trip-map.web.app → ☰ → «🤖 Підключити ШІ-агента…»).
TRIP_MAP_REFRESH_TOKEN=

# Access-токен. Опційно: якщо не заданий, здобувається з refresh-токена.
# TRIP_MAP_TOKEN=

# Адреса воркера. Опційно: дефолт беруть із trip.json профілю.
# TRIP_MAP_WORKER=https://trip-map-mcp.e--t.workers.dev
